<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="#E60F172A"
    android:padding="12dp"
    android:elevation="8dp">

    <!-- Header do Widget Flutuante -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:layout_marginBottom="6dp">

        <TextView
            android:id="@+id/txt_app_badge"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="🚚 ENTREGADOR"
            android:textColor="#22C55E"
            android:textSize="11sp"
            android:textStyle="bold" />

        <View
            android:layout_width="0dp"
            android:layout_height="1dp"
            android:layout_weight="1" />

        <TextView
            android:id="@+id/btn_close_widget"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text=" ✕ "
            android:textColor="#94A3B8"
            android:textSize="14sp"
            android:padding="4dp" />
    </LinearLayout>

    <!-- Indicador Principal de Status e Distância -->
    <TextView
        android:id="@+id/txt_status"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="AGUARDANDO CORRIDA"
        android:textColor="#F59E0B"
        android:textSize="12sp"
        android:textStyle="bold" />

    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginTop="4dp">

        <TextView
            android:id="@+id/txt_trip_km"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="0.0 km"
            android:textColor="#3B82F6"
            android:textSize="18sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/txt_cost_estimate"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text=" (R$ 0,00)"
            android:textColor="#EF4444"
            android:textSize="14sp"
            android:layout_gravity="center_vertical" />
    </LinearLayout>

    <!-- Totais do Dia -->
    <TextView
        android:id="@+id/txt_day_summary"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Hoje: R$ 0,00 | 0 km"
        android:textColor="#94A3B8"
        android:textSize="11sp"
        android:layout_marginTop="6dp" />

</LinearLayout>
